(assert
 (=
  (case 9999999999999999999999999999999999999
    :no-match                             :no-match
    9999999999999999999999999999999999999 :many-nines
    :default)
  :many-nines))

(assert
 (=
  (case 1N
    ((foo bar)) :list
    1N          :big-int
    :default)
  :big-int))

(assert
 (=
  (case 1N
    ((foo bar)) :list
    1           :integer
    :default)
  :integer))

:success
