(cpp/raw "namespace jank::cpp::case_::pass_implicitly_compatible_native_type
         {
           struct foo
           {
             bool is_foo() { return true; }
           };

           struct bar
           {
             /* Required to initialize the result variable for codegen. */
             bar() {}

             bar(foo const & _) {}

             bool is_bar() { return true; }
           };
         }")

(let* [foo (cpp/jank.cpp.case_.pass_implicitly_compatible_native_type.foo)
       bar (cpp/jank.cpp.case_.pass_implicitly_compatible_native_type.bar foo)
       res (case true
             true bar
             foo)]
  (when (.is_bar res)
    :success))
