#!/usr/bin/env bash

set -euo pipefail

case "$(uname -s)" in
  MSYS_NT*|MINGW*_NT*|CLANG*_NT*|CYGWIN_NT*)
    echo "Skipping on Windows"
    exit 0
    ;;
esac

rm -rf target
mkdir -p target

clang++ -gz -c src/lib.cpp -o target/lib.o $(jank print-cflags)
ar qc target/libtest.a target/lib.o

output="$(jank -Ltarget -ltest --module-path src run-main main 2>&1 || true)"
grep "error: :success" <<< "${output}"
grep "test_lib::do_call" <<< "${output}"
grep "main/thrower (arity 0)" <<< "${output}"

echo "All good"
