#!/usr/bin/env bash

set -euo pipefail

if [[ "$(uname -s)" =~ ^MSYS_NT.* ]];
then
  echo "Skipping on Windows"
else
  cd src
  rm -rf target
  jank run-main --module-path . throw-test | grep ":success"

  jank compile-module --module-path . foo

  jank run-main --module-path . throw-test | grep ":success"
fi
