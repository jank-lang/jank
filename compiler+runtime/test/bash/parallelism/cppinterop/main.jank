(cpp/raw "#include <mutex>

          std::mutex result_mutex{};
          int result{};

          template <typename T>
          void add(T t)
          {
            std::lock_guard<std::mutex> const lock{ result_mutex };
            result += t;
          }")

(def futures (mapv (fn [_]
                     (future (eval '(cpp/add 1))))
                   (range 100)))

(doseq [f futures]
  @f)

(when-not (= 100 cpp/result)
  (throw (ex-info "invaid result" {:result cpp/result})))
