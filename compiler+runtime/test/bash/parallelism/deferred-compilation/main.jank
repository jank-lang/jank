(defn work-9 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
(defn work-10 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))

(def all [work-0 work-1 work-2 work-3 work-4 work-5 work-6 work-7 work-8 work-9 work-10])

(let [fs (doall (map (fn [f] (future (f 10000))) all))
      res (reduce + (map deref fs))]
  (when-not (= 550055000 res)
    (throw (ex-info "invaid result" {:res res}))))
