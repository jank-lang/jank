(defn work-0 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
(defn work-1 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
(defn work-2 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
