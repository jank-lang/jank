+    #elif IS_FREEBSD
+    int get_page_protections(void* page) {
+        // FreeBSD exposes the current process' mappings through KERN_PROC_VMMAP.
+        // The records are variable-sized, so walk kve_structsize rather than
+        // assuming the buffer is an array of sizeof(struct kinfo_vmentry).
+        int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_VMMAP, getpid() };
+        size_t required = 0;
+        if(sysctl(mib, 4, nullptr, &required, nullptr, 0) != 0) {
+            throw internal_error("sysctl KERN_PROC_VMMAP size query failed: {}",
+                                 std::system_error(errno, std::system_category()).what());
+        }
+        if(required == 0) {
+            throw internal_error("sysctl KERN_PROC_VMMAP returned an empty map size");
+        }
+
+        std::vector<char> buffer(required);
+        size_t returned = 0;
+        bool loaded = false;
+        for(int attempt = 0; attempt < 4; ++attempt) {
+            returned = buffer.size();
+            if(sysctl(mib, 4, buffer.data(), &returned, nullptr, 0) == 0) {
+                loaded = true;
+                break;
+            }
+            const int error = errno;
+            if(error != ENOMEM || buffer.size() > std::numeric_limits<size_t>::max() / 2) {
+                throw internal_error("sysctl KERN_PROC_VMMAP failed: {}",
+                                     std::system_error(error, std::system_category()).what());
+            }
+            buffer.resize(buffer.size() * 2);
+        }
+        if(!loaded) {
+            throw internal_error("sysctl KERN_PROC_VMMAP changed repeatedly while reading");
+        }
+        if(returned > buffer.size()) {
+            throw internal_error("sysctl KERN_PROC_VMMAP returned an invalid size");
+        }
+
+        const auto target = reinterpret_cast<uintptr_t>(page);
+        constexpr size_t minimum_record_size = offsetof(struct kinfo_vmentry, kve_path);
+        size_t offset = 0;
+        while(offset < returned) {
+            const size_t remaining = returned - offset;
+            if(remaining < minimum_record_size) {
+                throw internal_error("truncated kinfo_vmentry fixed prefix in KERN_PROC_VMMAP result");
+            }
+            const auto& entry = *reinterpret_cast<const struct kinfo_vmentry*>(buffer.data() + offset);
+            const size_t record_size = entry.kve_structsize;
+            if(record_size == 0 || record_size < minimum_record_size || record_size > remaining) {
+                throw internal_error("invalid kve_structsize in KERN_PROC_VMMAP result");
+            }
+            const auto low = static_cast<uintptr_t>(entry.kve_start);
+            const auto high = static_cast<uintptr_t>(entry.kve_end);
+            if(low > high) {
+                throw internal_error("invalid address range in KERN_PROC_VMMAP result");
+            }
+            if(target >= low && target < high) {
+                int perms = 0;
+                if(entry.kve_protection & KVME_PROT_READ) perms |= PROT_READ;
+                if(entry.kve_protection & KVME_PROT_WRITE) perms |= PROT_WRITE;
+                if(entry.kve_protection & KVME_PROT_EXEC) perms |= PROT_EXEC;
+                return perms;
+            }
+            offset += record_size;
+        }
+        throw internal_error("page address is absent from KERN_PROC_VMMAP result");
+    }
     #else
     // Code for reading /proc/self/maps
