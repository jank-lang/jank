#!/usr/bin/env bash

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
build_dir="${here}/../build"
rm -rf "${build_dir}"/{CMakeCache.txt,CMakeFiles}
mkdir -p "${build_dir}"

# Assume clang, but allow overriding.
export CC="${CC:-clang}"
export CXX="${CXX:-clang++}"

# If stdout is a terminal, let's get some colors enabled.
if [[ -t 1 ]];
then
  export CMAKE_COLOR_DIAGNOSTICS=ON
else
  export CMAKE_COLOR_DIAGNOSTICS=OFF
fi

CMAKE_INSTALL_PREFIX=""
if [[ -n "${MSYSTEM:-}" ]]; then
  # Derive install prefix from MSYSTEM (not MINGW_PREFIX which may be
  # an absolute windows path in non login shells). MSYS2_ARG_CONV_EXCL
  # prevents MSYS2 from converting it back.
  _msys_install_prefix="/${MSYSTEM,,}"
  CMAKE_INSTALL_PREFIX="-DCMAKE_INSTALL_PREFIX=${_msys_install_prefix}"
  export MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX="
fi

cmake ${CMAKE_INSTALL_PREFIX:+$CMAKE_INSTALL_PREFIX} -S . -B "${build_dir}" -DCMAKE_COLOR_DIAGNOSTICS="${CMAKE_COLOR_DIAGNOSTICS}" "$@"

