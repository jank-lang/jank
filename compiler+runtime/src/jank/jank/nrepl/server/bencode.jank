(ns jank.nrepl.server.bencode)

(defmacro nth-byte [data i]
  `(int (cpp/aget (cpp/cast jtl.immutable_string ~data) (int ~i))))

(defmacro index-of [data start c]
  `(loop [i# (int ~start)]
     (if (== ~c (nth-byte ~data i#))
       i#
       (recur (inc i#)))))

(defmacro peek-byte [position data]
  `(nth-byte ~data (deref ~position)))

(defn- parse-recur [position data]
  (case (peek-byte position data)
    105 ;; \i - int `i<base 10 integer>e`
    (let [start (vswap! position inc)
          n     (index-of data start 101) ;; \e
          out   (parse-long (subs data start n))]
      (vreset! position (inc n))
      out)

    108 ;; \l - list `l<items>e`
    (do
      (vswap! position inc)
      (loop [out (transient [])]
        (if (== (peek-byte position data) 101) ;; \e
          (do
            (vswap! position inc)
            (persistent! out))
          (recur (conj! out
                        (parse-recur position data))))))

    100 ;; \d - dict `d<pairs>e`
    (do
      (vswap! position inc)
      (loop [out (transient {})]
        (if (== (peek-byte position data) 101) ;; \e
          (do
            (vswap! position inc)
            (persistent! out))
          (recur (assoc! out
                         (parse-recur position data)
                         (parse-recur position data))))))

    ;; netstring `<length>:<contents>`
    (let [start @position
          end   (index-of data start 58) ;; \:
          bytes (parse-long (subs data start end))
          start (inc end)
          out   (subs data start (+ start bytes))]
      (vreset! position (+ start bytes))
      out)))

(defn parse
  "Parse a bencode value from a string, returning jank data."
  [s]
  (try
    (when s
      (let [position (volatile! 0)]
        [(parse-recur position s) (not-empty (subs s @position))]))
    (catch :default _
      nil)))

(defn write
  "Write jank data as a bencode string."
  [x]
  (cond
    (number? x)
    (str "i" x "e")

    (string? x)
    (str (count x) ":" x)

    (keyword? x)
    (write (name x))

    (map? x)
    (str "d" (reduce-kv (fn [s k v] (str s (write k) (write v))) "" x) "e")

    (coll? x)
    (str "l" (apply str (map write x)) "e")

    (nil? x)
    (throw (ex-info "cannot write nil as bencode" {}))))
