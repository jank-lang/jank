(ns jank.nrepl.server.core
  (:include "jank/nrepl/server.hpp")
  (:require [clojure.string :as str]
            [jank.nrepl.server.handler :refer [handle-message]]
            [jank.nrepl.server.util :refer [abbreviate]]
            [jank.nrepl.server.bencode :as bencode]
            ;; handler implementations
            [jank.nrepl.server.handler.clone]
            [jank.nrepl.server.handler.close]
            [jank.nrepl.server.handler.completions]
            [jank.nrepl.server.handler.describe]
            [jank.nrepl.server.handler.eval]
            [jank.nrepl.server.handler.lookup]))

(cpp/raw "
namespace jank::util
{
  void print_exception(error_ref e);
}")

(def *verbose (atom false))
(def *ready?
  "A promise that is fulfilled when the nrepl server is ready or if an error
  occurs during initialization.

  The value of the promise will be nil on success or an exception info on
  failure."
  (promise))

(defn log [& args]
  (when @*verbose
    (apply println args)))

(defn response-for
  "Given a request/response pair, copy the session identification data from the
  request over to the response."
  [req resp]
  (merge resp (select-keys req ["id" "session"])))

(defn responses-for
  "Like `response-for` but accept one or multiple responses."
  [req resp-or-resps]
  (let [resps (if (sequential? resp-or-resps)
                resp-or-resps
                [resp-or-resps])]
    (map #(response-for req %) resps)))

(defn listen []
  (cpp/box (cpp/new jank.nrepl.server.native_server)))

(defn accept [^(:* jank.nrepl.server.native_server) server]
  (cpp/box (.accept server)))

(defn connected?
  "Is the client socket connected and available for reading/writing?"
  [^(:* jank.nrepl.server.native_client) client]
  (.is_connected client))

(defn read-message
  "Reads input from the boxed `jank.nrepl.server.native_client` CLIENT*
  and previously uncosumed input BUFFER, returning [msg buffer],
  where msg is the parsed message or nil if incomplete and buffer
  is the unconsumed input."
  [^(:* jank.nrepl.server.native_client) client buffer]
  (if-let [result (bencode/parse buffer)]
    result
    (let [chunk (.read_some client)
          input (str buffer chunk)]
      (if-let [result (bencode/parse input)]
        result
        [nil input]))))

(defn write-message
  "Encode the given message and write it to the client socket."
  [^(:* jank.nrepl.server.native_client) client msg]
  (let [msg-str (bencode/write msg)]
    (.write_some client (cpp/cast std.string msg-str))
    nil))

(defn- wrap-middleware [handler middleware]
  (try
    (cond
      (fn? middleware)
      (or (middleware handler) handler)

      (sequential? middleware)
      (reduce wrap-middleware handler (reverse middleware))

      (var? middleware)
      (wrap-middleware handler (deref middleware))

      (string? middleware)
      (wrap-middleware handler (symbol middleware))

      (symbol? middleware)
      ;; Many nREPL clients will automatically attempt to load cider, this will
      ;; fast fail those loads.
      ;; TODO: Remove if/when cider is supported on jank
      (if (= "cider.nrepl" (namespace middleware))
        (do
          (log "Cider nREPL middleware not supported on jank:" middleware)
          handler)
        (wrap-middleware handler (requiring-resolve middleware)))

      :else
      (do
        (log "Invalid nREPL middleware:" middleware)
        handler))
    (catch std.exception e
      (log "An exception was thrown while applying middleware:" middleware (.what e))
      handler)
    (catch jank.runtime.object_ref e
      (log "An exception was thrown while applying middleware:" middleware e)
      handler)
    (catch jank.error_ref e
      (log "An exception was thrown while applying middleware:" middleware)
      (cpp/jank.util.print_exception e)
      handler)
    (catch :default _
      (log "An exception was thrown while applying middleware:" middleware)
      handler)))

(defn- get-middleware []
  (remove
   str/blank?
   (str/split (.-nrepl_middleware cpp/jank.util.cli.opts) #",")))

(defn handle-client
  "For as long as the client is connected, read requests and write replies."
  [handler client*]
  (loop [[req remainder] nil]
    (when (connected? client*)
      (when req
        (log "<-" (pr-str (abbreviate req 20)))
        (let [resps (responses-for req (handler req))]
          (doseq [resp resps]
            (log "->" (pr-str (abbreviate resp 20)))
            (write-message client* resp))))
      (recur (read-message client* remainder)))))

(defn -main [& args]
  (when (some #{"-v" "--verbose"} args)
    (reset! *verbose true))

  (let [[err server*]
        (try
          [nil (listen)]
          (catch cpp/std.exception e
            (let [port (.-repl_port #cpp jank.util.cli.opts)]
              [(ex-info (str "Error binding server address: " port)
                        {:port port})
               nil])))]
    (if err
      (deliver *ready? err)
      (let [server  (cpp/unbox (:* jank.nrepl.server.native_server) server*)
            handler (wrap-middleware handle-message (get-middleware))]
        (spit ".nrepl-port" (str (.get_port server)))
        ;; Certain nREPL clients, such as Calva, depend on this exact string
        ;; format to assist with setting up a REPL via jack-in.
        (println "nREPL server started on port" (str (.get_port server))
                 "on host 127.0.0.1 -" (.get_endpoint server))
        (deliver *ready? nil)
        (while true
          (let [client* (accept server*)]
            (future
              (try
                (handle-client handler client*)
                (catch std.exception e
                  (println "An exception was thrown from the nREPL server thread:" (.what e)))
                (catch jank.runtime.object_ref e
                  (println "An exception was thrown from the nREPL server thread.")
                  (prn e))
                (catch jank.error_ref e
                  (println "An exception was thrown from the nREPL server thread.")
                  (cpp/jank.util.print_exception e))
                (catch :default _
                  (println "An unknown exception was thrown from the nREPL server thread."))))))))))

(defn background-main
  "Starts the nREPL server as a background thread. Returns a promise which will be delivered
   the server is running."
  [& args]
  (future (apply -main args))
  *ready?)
